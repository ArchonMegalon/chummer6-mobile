<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <ChummerEngineContractsPackageVersion>0.0.0-packageplane.mobile.20261110.1</ChummerEngineContractsPackageVersion>
    <ChummerCampaignContractsPackageVersion>0.0.0-packageplane.mobile.20261110.1</ChummerCampaignContractsPackageVersion>
    <ChummerPlayContractsPackageVersion>0.0.0-packageplane.mobile.20261110.1</ChummerPlayContractsPackageVersion>
    <ChummerUiKitPackageVersion>0.0.0-packageplane.mobile.20261110.1</ChummerUiKitPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Chummer.Engine.Contracts" Version="$(ChummerEngineContractsPackageVersion)" />
    <PackageVersion Include="Chummer.Campaign.Contracts" Version="$(ChummerCampaignContractsPackageVersion)" />
    <PackageVersion Include="Chummer.Play.Contracts" Version="$(ChummerPlayContractsPackageVersion)" />
    <PackageVersion Include="Chummer.Ui.Kit" Version="$(ChummerUiKitPackageVersion)" />
  </ItemGroup>
</Project>
